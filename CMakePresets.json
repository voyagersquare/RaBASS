{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "RaBASS Windows x64 Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-x64",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "RABASS_BUILD_TESTS": "ON" }
    }
  ],
  "buildPresets": [{ "name": "windows-release", "configurePreset": "windows-x64" }],
  "testPresets": [{ "name": "windows-release", "configurePreset": "windows-x64", "output": { "outputOnFailure": true } }]
}
